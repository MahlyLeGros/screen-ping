SECRET_KEY=change-me-to-a-long-random-string
ENABLE_API_DOCS=false
AUTH_COOKIE_SECURE=false
DATABASE_URL=sqlite:///./screen_ping.db
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
UPLOAD_DIR=uploads
MAX_IMAGE_BYTES=26214400
MAX_VIDEO_BYTES=52428800
MAX_AUDIO_BYTES=10485760
SEND_RATE_LIMIT=10

# Email (optional — without SMTP, codes are logged server-side)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@screenping.xyz
SMTP_USE_TLS=true
# Optional Google sign-in (Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=
VERIFICATION_CODE_EXPIRE_MINUTES=15
RESET_PASSWORD_ATTEMPT_LIMIT=10
RESET_PASSWORD_ATTEMPT_WINDOW_MINUTES=15
MAX_PENDING_PINGS_PER_RECEIVER=3
PENDING_PING_TTL_SECONDS=60
MAX_CAPTION_LENGTH=500
LOGIN_ATTEMPT_LIMIT_PER_IP=30
LOGIN_ATTEMPT_LIMIT_PER_USER=10
LOGIN_ATTEMPT_WINDOW_MINUTES=15
UPLOAD_RATE_LIMIT_PER_MINUTE=10
MEDIA_TTL_HOURS=1
