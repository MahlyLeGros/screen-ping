{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Ping",
  "mainBinaryName": "Screen Ping",
  "version": "../../desktop/package.json",
  "identifier": "com.screenping.tauri",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "publisher": "Screen Ping"
  }
}
